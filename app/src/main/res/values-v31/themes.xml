        <!-- Android 12+ Splash Screen -->
        <item name="android:windowSplashScreenBackground">@color/commerzo_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/commerzo_launcher_icon</item>

    </style>

</resources>
